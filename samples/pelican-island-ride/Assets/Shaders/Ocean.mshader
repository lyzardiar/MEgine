/* MENGINE_PARAMETERS
{"parameters":[
  {"name":"clock","label":"Clock (x=time, y=sunset)","type":"vector4","default":[0,0,0,0]}
]}
*/
// Pelican Island Ride — tropical animated ocean with turquoise shoals,
// shoreline foam rings, rolling wave normals, Fresnel sky reflection and sun glint.

fn wave_height(p: vec2<f32>, t: f32) -> f32 {
    return 0.24 * sin(dot(p, vec2<f32>(0.11, 0.16)) - t * 0.85)
        + 0.14 * sin(dot(p, vec2<f32>(0.21, -0.12)) - t * 1.15)
        + 0.06 * sin(dot(p, vec2<f32>(-0.14, 0.27)) + t * 0.95)
        + 0.025 * sin(dot(p, vec2<f32>(0.85, 0.62)) - t * 1.9);
}

// Mirrors the organic shoreline radius of the island in create-pelican-island-ride.py.
fn island_shore_radius(p: vec2<f32>) -> f32 {
    let ang = atan2(p.y, p.x);
    return 69.0
        + 8.5 * sin(2.0 * ang + 0.35)
        + 5.0 * cos(3.0 * ang - 0.55)
        + 2.5 * sin(5.0 * ang + 1.1);
}

fn mengine_lit_surface_hook(surface: MEngineSurface, uv: vec2<f32>, world_position: vec3<f32>) -> MEngineSurface {
    var s = surface;
    let clk = mengine_param_clock();
    let t = clk.x;
    let sunset = clamp(clk.y, 0.0, 1.0);
    let p = world_position.xz;

    let e = 0.15;
    let dx = (wave_height(p + vec2<f32>(e, 0.0), t) - wave_height(p - vec2<f32>(e, 0.0), t)) / (2.0 * e);
    let dz = (wave_height(p + vec2<f32>(0.0, e), t) - wave_height(p - vec2<f32>(0.0, e), t)) / (2.0 * e);
    s.normal = normalize(vec3<f32>(-dx * 0.95, 1.0, -dz * 0.95));

    let dist = length(p);
    let shore_r = island_shore_radius(p);
    let offshore = max(dist - shore_r, 0.0);

    // Tropical turquoise near the beach, sapphire blue offshore; warms at golden hour.
    let shallow_day = vec3<f32>(0.04, 0.44, 0.46);
    let deep_day = vec3<f32>(0.012, 0.11, 0.24);
    let shallow_sunset = vec3<f32>(0.05, 0.25, 0.27);
    let deep_sunset = vec3<f32>(0.014, 0.055, 0.12);

    let shallow = mix(shallow_day, shallow_sunset, sunset);
    let deep = mix(deep_day, deep_sunset, sunset);
    let depth_t = smoothstep(0.0, 56.0, offshore);
    var water = mix(shallow, deep, depth_t);

    // Animated shoreline surf bands + subtle wave crest foam.
    let surf_phase = sin(offshore * 0.95 - t * 2.4 + sin(atan2(p.y, p.x) * 7.0) * 0.8);
    let surf_ring = (1.0 - smoothstep(0.0, 11.5, offshore)) * smoothstep(0.32, 0.82, surf_phase);
    let shore_edge = 1.0 - smoothstep(0.0, 2.8, offshore);
    let crest = smoothstep(0.28, 0.43, wave_height(p, t)) * 0.28;
    let foam = clamp(shore_edge * 0.92 + surf_ring * 0.65 + crest, 0.0, 1.0);

    let foam_col = mix(vec3<f32>(0.90, 0.96, 0.98), vec3<f32>(0.98, 0.82, 0.68), sunset);
    s.base_color = mix(water, foam_col, foam * 0.85);
    s.roughness = clamp(0.11 + foam * 0.45, 0.08, 0.72);
    s.metallic = 0.02;

    let view = normalize(frame.camera_position.xyz - world_position);
    let light = normalize(-frame.directional_direction.xyz);
    let half_dir = normalize(view + light);
    let fresnel = pow(1.0 - clamp(dot(s.normal, view), 0.0, 1.0), 4.0);
    let glint = pow(max(dot(s.normal, half_dir), 0.0), 140.0);
    let glint_col = mix(vec3<f32>(1.0, 0.95, 0.82), vec3<f32>(1.0, 0.60, 0.28), sunset);
    let sky_tint = mix(vec3<f32>(0.18, 0.46, 0.68), vec3<f32>(0.48, 0.22, 0.16), sunset);
    s.emissive = water * 0.05 + sky_tint * fresnel * 0.24 + glint_col * glint * (0.75 + sunset * 0.55);
    return s;
}
