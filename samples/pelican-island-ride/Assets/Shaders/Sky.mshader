/* MENGINE_PARAMETERS
{"parameters":[
  {"name":"clock","label":"Clock (x=time, y=sunset)","type":"vector4","default":[0,0,0,0]}
]}
*/
// Pelican Island Ride — procedural coastal sky dome with day / golden-hour blend,
// soft solar halo and drifting cumulus wisps.

fn sky_hash(p: vec2<f32>) -> f32 {
    var q = fract(p * vec2<f32>(123.34, 456.21));
    q += dot(q, q + 45.32);
    return fract(q.x * q.y);
}

fn sky_noise(p: vec2<f32>) -> f32 {
    let i = floor(p);
    let f = fract(p);
    let u = f * f * (3.0 - 2.0 * f);
    let a = sky_hash(i);
    let b = sky_hash(i + vec2<f32>(1.0, 0.0));
    let c = sky_hash(i + vec2<f32>(0.0, 1.0));
    let d = sky_hash(i + vec2<f32>(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

fn sky_fbm(p: vec2<f32>) -> f32 {
    var v = 0.0;
    var amp = 0.5;
    var q = p;
    for (var i = 0; i < 4; i = i + 1) {
        v += amp * sky_noise(q);
        q *= 2.08;
        amp *= 0.5;
    }
    return v;
}

fn mengine_surface_hook(color: vec4<f32>, uv: vec2<f32>, world_position: vec3<f32>, world_normal: vec3<f32>) -> vec4<f32> {
    let clk = mengine_param_clock();
    let t = clk.x;
    let sunset = clamp(clk.y, 0.0, 1.0);
    let ray = normalize(world_position - frame.camera_position.xyz);

    let day_zenith = vec3<f32>(0.07, 0.30, 0.72);
    let day_horizon = vec3<f32>(0.55, 0.80, 0.94);
    let sunset_zenith = vec3<f32>(0.04, 0.06, 0.19);
    let sunset_horizon = vec3<f32>(0.85, 0.34, 0.16);

    let zenith = mix(day_zenith, sunset_zenith, sunset);
    let horizon = mix(day_horizon, sunset_horizon, sunset);
    let sky = mix(horizon, zenith, pow(clamp(ray.y, 0.0, 1.0), 0.55));

    let sun_dir = normalize(mix(vec3<f32>(-0.55, 0.62, -0.56), vec3<f32>(-0.84, 0.17, -0.51), sunset));
    let align = max(dot(ray, sun_dir), 0.0);
    let halo_col = mix(vec3<f32>(0.95, 0.88, 0.68), vec3<f32>(1.0, 0.45, 0.16), sunset);
    let halo = pow(align, 18.0) * 0.28 * halo_col + pow(align, 260.0) * 0.95 * halo_col;
    let disk = smoothstep(0.9991, 0.9996, align) * mix(vec3<f32>(4.5, 4.2, 3.5), vec3<f32>(5.5, 3.6, 2.2), sunset);

    // Drifting puffy clouds on the upper hemisphere.
    var col = sky + halo + disk;
    if (ray.y > 0.02) {
        let proj = ray.xz / (ray.y + 0.18);
        let c_uv = proj * 0.75 + vec2<f32>(t * 0.008, -t * 0.004);
        let d = sky_fbm(c_uv + vec2<f32>(sky_fbm(c_uv * 0.6) * 0.55, 0.0));
        let band = smoothstep(0.02, 0.22, ray.y) * smoothstep(0.95, 0.35, ray.y);
        let cloud = smoothstep(0.49, 0.74, d) * band * 0.78;
        let cloud_day = mix(vec3<f32>(0.84, 0.90, 0.96), vec3<f32>(1.0, 0.99, 0.96), align * 0.5 + 0.5);
        let cloud_sun = mix(vec3<f32>(0.26, 0.20, 0.28), vec3<f32>(1.0, 0.62, 0.34), pow(align, 2.5));
        col = mix(col, mix(cloud_day, cloud_sun, sunset), cloud);
    }

    return vec4<f32>(col, 1.0);
}
