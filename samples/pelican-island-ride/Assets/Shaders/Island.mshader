/* MENGINE_PARAMETERS
{"parameters":[
  {"name":"clock","label":"Clock (x=time, y=sunset)","type":"vector4","default":[0,0,0,0]}
],
"textures":[
  {"name":"surface_normal","label":"Normal Map","type":"data","default":"Assets/Textures/island-normal.png"}
]}
*/
// Pelican Island Ride — island terrain shader.
// Blends wet shoreline sand, golden beach, lush coastal grass and volcanic cliffs
// using height, slope, procedural fbm variation and derivative tangent-space normals.

fn hash21(p: vec2<f32>) -> f32 {
    var q = fract(p * vec2<f32>(127.1, 311.7));
    q += dot(q, q + 34.5);
    return fract(q.x * q.y);
}

fn vnoise(p: vec2<f32>) -> f32 {
    let i = floor(p);
    let f = fract(p);
    let u = f * f * (3.0 - 2.0 * f);
    let a = hash21(i);
    let b = hash21(i + vec2<f32>(1.0, 0.0));
    let c = hash21(i + vec2<f32>(0.0, 1.0));
    let d = hash21(i + vec2<f32>(1.0, 1.0));
    return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}

fn fbm2(p: vec2<f32>) -> f32 {
    var v = 0.0;
    var amp = 0.5;
    var q = p;
    for (var i = 0; i < 4; i = i + 1) {
        v += amp * vnoise(q);
        q *= 2.03;
        amp *= 0.5;
    }
    return v;
}

fn tangent_normal(geom: vec3<f32>, world_position: vec3<f32>, uv: vec2<f32>, encoded: vec3<f32>, scale: f32) -> vec3<f32> {
    let pdx = dpdx(world_position);
    let pdy = dpdy(world_position);
    let udx = dpdx(uv);
    let udy = dpdy(uv);
    let t_raw = cross(pdy, geom) * udx.x + cross(geom, pdx) * udy.x;
    let b_raw = cross(pdy, geom) * udx.y + cross(geom, pdx) * udy.y;
    let inv = inverseSqrt(max(max(dot(t_raw, t_raw), dot(b_raw, b_raw)), 0.000001));
    let tangent = t_raw * inv;
    let bitangent = b_raw * inv;
    var tn = encoded * 2.0 - vec3<f32>(1.0);
    tn.x *= scale;
    tn.y *= scale;
    return normalize(tangent * tn.x + bitangent * tn.y + geom * tn.z);
}

fn mengine_lit_surface_hook(surface: MEngineSurface, uv: vec2<f32>, world_position: vec3<f32>) -> MEngineSurface {
    var s = surface;
    let base_normal = normalize(s.normal);
    let mapped = tangent_normal(base_normal, world_position, uv, mengine_texture_surface_normal(uv).rgb, 1.05);
    s.normal = normalize(mix(base_normal, mapped, 0.85));

    let slope = clamp(1.0 - dot(base_normal, vec3<f32>(0.0, 1.0, 0.0)), 0.0, 1.0);
    let y = world_position.y;
    let mottle = fbm2(world_position.xz * 0.09);
    let detail = fbm2(world_position.xz * 0.34);

    let wet_sand = vec3<f32>(0.42, 0.33, 0.21);
    let warm_sand = mix(vec3<f32>(0.76, 0.64, 0.41), vec3<f32>(0.84, 0.72, 0.49), detail);
    let meadow = mix(vec3<f32>(0.15, 0.36, 0.14), vec3<f32>(0.30, 0.50, 0.19), mottle);
    let ridge_grass = mix(vec3<f32>(0.10, 0.26, 0.12), vec3<f32>(0.22, 0.39, 0.16), detail);
    let rock = mix(vec3<f32>(0.24, 0.22, 0.21), vec3<f32>(0.42, 0.38, 0.35), mottle);

    var col = mix(wet_sand, warm_sand, smoothstep(0.05, 0.85, y));
    col = mix(col, meadow, smoothstep(1.35, 3.2, y + mottle * 0.8));
    col = mix(col, ridge_grass, smoothstep(9.0, 18.0, y));
    col = mix(col, rock, smoothstep(0.24, 0.56, slope + smoothstep(16.0, 24.0, y) * 0.22));

    s.base_color = col;
    s.roughness = mix(0.86, 0.52, smoothstep(0.8, 0.0, y)) * (0.92 + 0.14 * detail);
    s.metallic = 0.0;
    return s;
}
