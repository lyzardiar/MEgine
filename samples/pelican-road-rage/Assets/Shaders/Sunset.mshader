fn mengine_surface_hook(color: vec4<f32>, uv: vec2<f32>, world_position: vec3<f32>, world_normal: vec3<f32>) -> vec4<f32> {
    let ray=normalize(world_position-frame.camera_position.xyz);
    let upper=smoothstep(-0.025,0.38,ray.y);
    let sky=mix(vec3<f32>(0.50,0.105,0.12),vec3<f32>(0.033,0.019,0.065),upper);
    let sun=normalize(vec3<f32>(-0.9,0.13,-0.36));
    let alignment=max(0.0,dot(ray,sun));
    let halo=pow(alignment,48.0)*vec3<f32>(0.55,0.18,0.05)+pow(alignment,520.0)*vec3<f32>(1.1,0.56,0.24);
    let disk=smoothstep(0.99925,0.99965,alignment)*vec3<f32>(6.0,4.9,3.8);
    return vec4<f32>(sky+halo+disk,1.0);
}
