// MiYu: thin world-space command and selection circles.
fn mengine_lit_surface_hook(surface: MEngineSurface, uv: vec2<f32>, world_position: vec3<f32>) -> MEngineSurface {
    var s=surface;let r=length(uv-vec2<f32>(0.5))*2.0;
    s.alpha=(1.0-smoothstep(0.91,0.98,r))*smoothstep(0.79,0.86,r);
    s.emissive=s.base_color*0.8;return s;
}
