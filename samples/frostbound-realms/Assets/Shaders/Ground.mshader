// MiYu: 64 terrain chunks replace 1024 independently shaded cubes.
struct FrostGround { materials: vec4<f32>, painted: vec2<f32>, fog: f32 }
fn frost_cell(p: vec2<i32>) -> f32 {
    var data=array<vec4<f32>,9>(mengine_param_cells0(),mengine_param_cells1(),mengine_param_cells2(),mengine_param_cells3(),mengine_param_cells4(),mengine_param_cells5(),mengine_param_cells6(),mengine_param_cells7(),mengine_param_cells8());
    let i=u32(clamp(p.y,0,5)*6+clamp(p.x,0,5));
    return data[i/4u][i%4u];
}
fn frost_ground(p: vec2<f32>) -> FrostGround {
    let local=(p-object.model[3].xz+vec2<f32>(4.0))/2.0+vec2<f32>(0.5);
    let cell=vec2<i32>(floor(local));
    let blend=smoothstep(vec2<f32>(0.0),vec2<f32>(1.0),fract(local));
    let values=vec4<f32>(frost_cell(cell),frost_cell(cell+vec2<i32>(1,0)),frost_cell(cell+vec2<i32>(0,1)),frost_cell(cell+vec2<i32>(1,1)));
    let kinds=floor(values/2.0);let surfaces=floor(kinds/3.0);let terrain=kinds-surfaces*3.0;
    let weights=vec4<f32>((1.0-blend.x)*(1.0-blend.y),blend.x*(1.0-blend.y),(1.0-blend.x)*blend.y,blend.x*blend.y);
    let zero=vec4<f32>(0.0);let one=vec4<f32>(1.0);
    let masks=vec4<f32>(dot(select(zero,one,terrain==one),weights),dot(select(zero,one,terrain==vec4<f32>(2.0)),weights),dot(select(zero,one,surfaces==one),weights),dot(select(zero,one,surfaces==vec4<f32>(2.0)),weights));
    let painted=vec2<f32>(dot(select(zero,one,surfaces==vec4<f32>(3.0)),weights),dot(select(zero,one,surfaces==vec4<f32>(4.0)),weights));
    return FrostGround(masks,painted,dot(values-kinds*2.0,weights));
}
fn frost_noise(p: vec2<f32>) -> f32 {
    let cell=floor(p);let blend=smoothstep(vec2<f32>(0.0),vec2<f32>(1.0),fract(p));
    let corners=vec4<f32>(dot(cell,vec2<f32>(127.1,311.7)),dot(cell+vec2<f32>(1.0,0.0),vec2<f32>(127.1,311.7)),dot(cell+vec2<f32>(0.0,1.0),vec2<f32>(127.1,311.7)),dot(cell+vec2<f32>(1.0,1.0),vec2<f32>(127.1,311.7)));
    let values=fract(sin(corners)*43758.5453);
    return mix(mix(values.x,values.y,blend.x),mix(values.z,values.w,blend.x),blend.y);
}
// MiYu: shared weights keep color, normal, roughness and scan height registered across translated tiles.
fn frost_tile_weight(amount: f32, first: vec4<f32>, second: vec4<f32>) -> f32 {
    return smoothstep(0.18,0.82,amount+(second.a-first.a)*0.35);
}
// MiYu: OpenGL normal green points opposite texture V; project detail into each face's tangent plane.
fn frost_bump(packed: vec4<f32>, geometric: vec3<f32>, axis_u: vec3<f32>, axis_v: vec3<f32>, strength: f32) -> vec3<f32> {
    let xy=packed.rg*2.0-vec2<f32>(1.0);
    let z=sqrt(max(0.04,1.0-dot(xy,xy)));
    let detail=(axis_u*xy.x-axis_v*xy.y)*(strength/z);
    return normalize(geometric+detail-geometric*dot(detail,geometric));
}
// MiYu: wrapped gutters and explicit gradients keep soil/grass atlas panels separate at tile repeats.
fn frost_atlas_uv(uv: vec2<f32>, layer: f32) -> vec2<f32> { return (fract(uv)*1024.0+vec2<f32>(4.0+layer*1032.0,4.0))/vec2<f32>(2064.0,1032.0); }
fn frost_atlas_color(uv: vec2<f32>, layer: f32) -> vec3<f32> {
    let scale=vec2<f32>(1024.0/2064.0,1024.0/1032.0);
    return textureSampleGrad(mengine_custom_texture_0,material_sampler,frost_atlas_uv(uv,layer),dpdx(uv)*scale,dpdy(uv)*scale).rgb;
}
fn frost_atlas_nrh(uv: vec2<f32>, layer: f32) -> vec4<f32> {
    let scale=vec2<f32>(1024.0/2064.0,1024.0/1032.0);
    return textureSampleGrad(mengine_custom_texture_3,material_sampler,frost_atlas_uv(uv,layer),dpdx(uv)*scale,dpdy(uv)*scale);
}
// MiYu: each cliff tile selects a wrapped scan panel; gradients exclude the atlas layer offset.
fn frost_cliff_uv(uv: vec2<f32>, layer: f32) -> vec2<f32> { return (fract(uv)*1024.0+vec2<f32>(4.0+layer*1032.0,4.0))/vec2<f32>(3096.0,1032.0); }
fn frost_cliff_color(uv: vec2<f32>, layer: f32) -> vec3<f32> {
    let scale=vec2<f32>(1024.0/3096.0,1024.0/1032.0);
    return textureSampleGrad(base_color_texture,material_sampler,frost_cliff_uv(uv,layer),dpdx(uv)*scale,dpdy(uv)*scale).rgb;
}
fn frost_cliff_nrh(uv: vec2<f32>, layer: f32) -> vec4<f32> {
    let scale=vec2<f32>(1024.0/3096.0,1024.0/1032.0);
    return textureSampleGrad(metallic_roughness_texture,material_sampler,frost_cliff_uv(uv,layer),dpdx(uv)*scale,dpdy(uv)*scale);
}
fn mengine_lit_surface_hook(surface: MEngineSurface, uv: vec2<f32>, world_position: vec3<f32>) -> MEngineSurface {
    var s=surface;let p=world_position.xz;let geometric=normalize(surface.normal);
    let cliff_style=clamp(floor(uv.x/2.0),0.0,2.0);let contact=clamp(uv.x-cliff_style*2.0,0.0,1.0);
    // World-space offsets stay below the one-unit interpolation margin shared by adjacent chunks.
    let drift=vec2<f32>(frost_noise(p*0.42),frost_noise(p*0.42+vec2<f32>(37.0,19.0)))-vec2<f32>(0.5);
    let shore_fields=frost_ground(p+drift*1.4).materials;let ground=frost_ground(p+drift*0.9);let fields=ground.materials;
    let soil_uv=p*0.32;let snow_uv=p*0.5;let stone_uv=p*0.32;
    let offset=vec2<f32>(0.37,0.61);let tile_amount=frost_noise(p*0.21+vec2<f32>(11.0,7.0));
    let soil_a=frost_atlas_nrh(soil_uv,0.0);let soil_b=frost_atlas_nrh(soil_uv+offset,0.0);
    let snow_a=mengine_texture_snow_nrh(snow_uv);let snow_b=mengine_texture_snow_nrh(snow_uv+offset);
    let soil_weight=frost_tile_weight(tile_amount,soil_a,soil_b);let snow_weight=frost_tile_weight(tile_amount,snow_a,snow_b);
    let litter=mix(frost_atlas_color(soil_uv,0.0),frost_atlas_color(soil_uv+offset,0.0),soil_weight);
    let snow=mix(mengine_texture_snow(snow_uv).rgb,mengine_texture_snow(snow_uv+offset).rgb,snow_weight);let stone=mengine_texture_stone(stone_uv).rgb;
    let soil_nrh=mix(soil_a,soil_b,soil_weight);let snow_nrh=mix(snow_a,snow_b,snow_weight);let stone_nrh=mengine_texture_stone_nrh(stone_uv);
    let grass_uv=p*0.36;let grass_a=frost_atlas_nrh(grass_uv,1.0);let grass_b=frost_atlas_nrh(grass_uv+offset,1.0);let grass_weight=frost_tile_weight(tile_amount,grass_a,grass_b);
    let grass_nrh=mix(grass_a,grass_b,grass_weight);let grass=mix(frost_atlas_color(grass_uv,1.0),frost_atlas_color(grass_uv+offset,1.0),grass_weight)*vec3<f32>(0.64,0.93,0.60);
    let grass_cover=smoothstep(0.18,0.82,ground.painted.x+(grass_nrh.a-soil_nrh.a)*0.15);let rock_cover=smoothstep(0.18,0.82,ground.painted.y+(stone_nrh.a-soil_nrh.a)*0.15);
    let broad=frost_noise(p*0.085+vec2<f32>(4.0,9.0));let medium=frost_noise(p*0.31+vec2<f32>(23.0,5.0));let fine=frost_noise(p*1.2);
    let natural_cover=smoothstep(0.3,0.7,broad*0.58+medium*0.3+fine*0.12);
    let cover=natural_cover*(1.0-fields.z-fields.w-ground.painted.x-ground.painted.y)+fields.w;
    // MiYu: thin snow settles between raised litter; a narrow wet-soil band follows the melting edge.
    let wall=uv.y<0.0;let wall_depth=select(uv.y,-uv.y-1.0,wall);
    let shelf=smoothstep(0.65,0.95,abs(geometric.y))*select(1.0,0.0,wall);
    // MiYu: gentle entrances retain their painted ground; steep faces expose rock beneath thin snow.
    let slope=1.0-smoothstep(0.60,0.85,geometric.y);
    let rim=smoothstep(0.04,0.55,uv.y+(medium-0.5)*min(max(uv.y,0.0),0.3))*shelf;
    let snow_cover=smoothstep(-0.09,0.09,cover-0.5+(snow_nrh.a-soil_nrh.a)*0.32)*(1.0-slope*0.85)*(1.0-rim*0.95);
    let melt=(1.0-snow_cover)*smoothstep(0.18,0.5,cover);
    let road=smoothstep(0.22,0.8,fields.y+(stone_nrh.a-0.5)*0.18)*(1.0-grass_cover)*(1.0-rock_cover);
    let shore=shore_fields.x+(frost_noise(p*2.3)-0.5)*0.065;
    let wet=smoothstep(0.18,0.51,shore);
    let soil_tint=mix(vec3<f32>(0.64,0.69,0.59),vec3<f32>(0.84,0.79,0.67),medium);
    let damp=mix(vec3<f32>(1.0),vec3<f32>(0.56,0.61,0.58),melt);
    let snow_color=snow*vec3<f32>(0.91,0.95,1.0);
    let soil=mix(litter*soil_tint*damp,snow_color,snow_cover);
    let road_snow=snow_cover*(1.0-smoothstep(0.2,0.55,stone_nrh.a))*0.6;
    let road_stone=mix(stone,vec3<f32>(dot(stone,vec3<f32>(0.2126,0.7152,0.0722))),0.65)*vec3<f32>(0.74,0.77,0.78);
    let painted=mix(mix(soil,grass,grass_cover),stone*vec3<f32>(0.81,0.84,0.85),rock_cover);
    let dry=mix(mix(painted,stone*vec3<f32>(0.65,0.70,0.74),slope*(1.0-snow_cover)*0.65),mix(road_stone,snow_color,road_snow),road);
    let gravel_mix=0.45+frost_noise(p*1.6)*0.35;let gravel=mix(litter,stone,gravel_mix);
    let bank=mix(dry,gravel*vec3<f32>(0.31,0.34,0.3),wet);
    let phase=mengine_param_water_time().x;
    let wave=sin(p.x*4.2+p.y*2.6+frost_noise(p*0.8)*5.0-phase*1.3);
    s.base_color=bank;
    let painted_nrh=mix(mix(mix(soil_nrh,snow_nrh,snow_cover),grass_nrh,grass_cover),stone_nrh,rock_cover);
    let packed=mix(mix(mix(painted_nrh,stone_nrh,slope*(1.0-snow_cover)*0.65),mix(stone_nrh,snow_nrh,road_snow),road),mix(soil_nrh,stone_nrh,gravel_mix),wet);
    let dry_roughness=mix(clamp(packed.b,0.48,1.0),0.52,melt*(1.0-road));
    s.roughness=mix(dry_roughness,0.4,wet);s.metallic=0.0;
    let ground_normal=frost_bump(packed,geometric,vec3<f32>(1,0,0),vec3<f32>(0,0,1),0.7);
    s.normal=ground_normal;
    let cliff=select(1.0-smoothstep(0.3,0.6,abs(geometric.y)),1.0,wall);
    let mapping=select(select(mengine_param_cliff_mapping(),vec4<f32>(0.3,0.3,0.35,0),cliff_style==1.0),vec4<f32>(0.4,0.4,0.65,0),cliff_style==2.0);
    let side_x=vec2<f32>(p.y,-world_position.y)*mapping.xy;let side_z=vec2<f32>(p.x,-world_position.y)*mapping.xy;
    let side_weight=abs(geometric.x)/max(abs(geometric.x)+abs(geometric.z),0.0001);
    // MiYu: cliff color and linear NRH reuse the standard color/MR bindings; this hook supplies all final PBR channels.
    let side_nx=frost_cliff_nrh(side_x,cliff_style);let side_nz=frost_cliff_nrh(side_z,cliff_style);
    let side_color=mix(frost_cliff_color(side_z,cliff_style),frost_cliff_color(side_x,cliff_style),side_weight);
    let side_normal=normalize(mix(frost_bump(side_nz,geometric,vec3<f32>(1,0,0),vec3<f32>(0,-1,0),mapping.z),frost_bump(side_nx,geometric,vec3<f32>(0,0,1),vec3<f32>(0,-1,0),mapping.z),side_weight));
    // MiYu: the same scanned rock wraps over exposed crowns and breaks through the soil on ramps.
    let crown_uv=p*mapping.xy;
    let crown_nrh=frost_cliff_nrh(crown_uv,cliff_style);
    let crown_color=frost_cliff_color(crown_uv,cliff_style)*vec3<f32>(0.78,0.82,0.86);
    let outcrop=smoothstep(0.12,0.72,rim+slope*0.35+(crown_nrh.a-soil_nrh.a)*0.18)*(1.0-snow_cover)*(1.0-road*0.8)*(1.0-wet);
    s.base_color=mix(s.base_color,crown_color,outcrop);
    s.normal=normalize(mix(s.normal,frost_bump(crown_nrh,geometric,vec3<f32>(1,0,0),vec3<f32>(0,0,1),mapping.z),outcrop));
    s.roughness=mix(s.roughness,clamp(crown_nrh.b,0.48,1.0),outcrop);
    // MiYu: mesh UVs carry cliff depth; exposed shelves keep a soil cap and shaded rock foot.
    let cap=1.0-smoothstep(0.02,0.20,wall_depth+(side_nz.a-0.5)*0.10);
    let foot=mix(1.0,0.67,smoothstep(0.55,1.0,contact));
    let cap_color=mix(mix(crown_color,litter*soil_tint,0.25+medium*0.2),snow_color,snow_cover*(1.0-smoothstep(0.0,0.08,wall_depth)));
    let cliff_color=mix(side_color*vec3<f32>(0.78,0.82,0.86),cap_color,cap)*foot;
    s.base_color=mix(s.base_color,cliff_color,cliff);
    s.base_color*=1.0-0.3*contact*shelf;
    s.normal=normalize(mix(s.normal,side_normal,cliff));s.roughness=mix(s.roughness,mix(side_nz.b,side_nx.b,side_weight),cliff);
    // MiYu: opaque beds sit below a separate alpha water layer; land cliffs retain their geometry.
    let layer=mengine_param_water_layer().x;
    let shoreline=frost_ground(p+drift*0.55).materials.x;
    let submerged=shoreline>0.5;
    if layer<0.5 {if !wall&&submerged {discard;}}
    else {
        if !submerged {discard;}
        s.base_color=gravel*vec3<f32>(0.72,0.76,0.68);s.normal=ground_normal;s.roughness=0.82;
        if layer>1.5 {
            let deep=smoothstep(0.5,0.96,shoreline);
            let cross_wave=cos(p.y*6.1-p.x*1.7+phase*0.85);
            let foam_line=(1.0-smoothstep(0.5,0.58,shoreline))*smoothstep(0.52,0.8,frost_noise(p*3.7+vec2<f32>(phase*0.06)));
            s.base_color=mix(vec3<f32>(0.06,0.17,0.16),vec3<f32>(0.025,0.085,0.105),deep)+vec3<f32>(foam_line*0.12);
            s.normal=normalize(geometric+vec3<f32>(wave*0.075,0.0,cross_wave*0.055));s.roughness=0.16;
            s.alpha=mix(0.25,0.65,deep);s.emissive=vec3<f32>(0.004,0.012,0.014);
        }
    }
    return s;
}
fn mengine_surface_hook(color: vec4<f32>, uv: vec2<f32>, world_position: vec3<f32>, world_normal: vec3<f32>) -> vec4<f32> {
    let fog=frost_ground(world_position.xz).fog;
    return vec4<f32>(mix(vec3<f32>(0.012,0.025,0.038),color.rgb,smoothstep(0.05,1.0,fog)),color.a);
}
