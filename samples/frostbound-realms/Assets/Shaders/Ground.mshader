/* MENGINE_PARAMETERS
{"parameters":[{"name":"cells0","type":"vector4","default":[1,1,1,1]},{"name":"cells1","type":"vector4","default":[1,1,1,1]},{"name":"cells2","type":"vector4","default":[1,1,1,1]},{"name":"cells3","type":"vector4","default":[1,1,1,1]},{"name":"cells4","type":"vector4","default":[1,1,1,1]},{"name":"cells5","type":"vector4","default":[1,1,1,1]},{"name":"cells6","type":"vector4","default":[1,1,1,1]},{"name":"cells7","type":"vector4","default":[1,1,1,1]},{"name":"cells8","type":"vector4","default":[1,1,1,1]}],"textures":[{"name":"soil","type":"color","default":"Assets/Textures/forest_ground_04_diff_1k.jpg"},{"name":"snow","type":"color","default":"Assets/Textures/snow_02_diff_1k.jpg"},{"name":"stone","type":"color","default":"Assets/Textures/rocky_terrain_diff_1k.jpg"},{"name":"soil_nrh","type":"data","default":"Assets/Textures/forest_ground_04_nrh_1k.png"},{"name":"snow_nrh","type":"data","default":"Assets/Textures/snow_02_nrh_1k.png"},{"name":"stone_nrh","type":"data","default":"Assets/Textures/rocky_terrain_nrh_1k.png"}]}
*/
// MiYu: 64 terrain chunks replace 1024 independently shaded cubes.
fn frost_cell(p: vec2<i32>) -> vec3<f32> {
    var data=array<vec4<f32>,9>(mengine_param_cells0(),mengine_param_cells1(),mengine_param_cells2(),mengine_param_cells3(),mengine_param_cells4(),mengine_param_cells5(),mengine_param_cells6(),mengine_param_cells7(),mengine_param_cells8());
    let i=u32(clamp(p.y,0,5)*6+clamp(p.x,0,5));
    let value=data[i/4u][i%4u];
    let kind=floor(value/2.0);
    return vec3<f32>(select(0.0,1.0,kind==1.0),select(0.0,1.0,kind==2.0),value-kind*2.0);
}
fn frost_ground(p: vec2<f32>) -> vec3<f32> {
    let local=(p-object.model[3].xz+vec2<f32>(4.0))/2.0+vec2<f32>(0.5);
    let cell=vec2<i32>(floor(local));
    let blend=smoothstep(vec2<f32>(0.0),vec2<f32>(1.0),fract(local));
    return mix(mix(frost_cell(cell),frost_cell(cell+vec2<i32>(1,0)),blend.x),mix(frost_cell(cell+vec2<i32>(0,1)),frost_cell(cell+vec2<i32>(1,1)),blend.x),blend.y);
}
fn frost_noise(p: vec2<f32>) -> f32 {
    let cell=floor(p);let blend=smoothstep(vec2<f32>(0.0),vec2<f32>(1.0),fract(p));
    let corners=vec4<f32>(dot(cell,vec2<f32>(127.1,311.7)),dot(cell+vec2<f32>(1.0,0.0),vec2<f32>(127.1,311.7)),dot(cell+vec2<f32>(0.0,1.0),vec2<f32>(127.1,311.7)),dot(cell+vec2<f32>(1.0,1.0),vec2<f32>(127.1,311.7)));
    let values=fract(sin(corners)*43758.5453);
    return mix(mix(values.x,values.y,blend.x),mix(values.z,values.w,blend.x),blend.y);
}
// MiYu: OpenGL normal green points opposite texture V; project detail into each face's tangent plane.
fn frost_bump(packed: vec4<f32>, geometric: vec3<f32>, axis_u: vec3<f32>, axis_v: vec3<f32>, strength: f32) -> vec3<f32> {
    let xy=packed.rg*2.0-vec2<f32>(1.0);
    let z=sqrt(max(0.04,1.0-dot(xy,xy)));
    let detail=(axis_u*xy.x-axis_v*xy.y)*(strength/z);
    return normalize(geometric+detail-geometric*dot(detail,geometric));
}
fn mengine_lit_surface_hook(surface: MEngineSurface, uv: vec2<f32>, world_position: vec3<f32>) -> MEngineSurface {
    var s=surface;let p=world_position.xz;let geometric=normalize(surface.normal);
    // World-space offsets stay below the one-unit interpolation margin shared by adjacent chunks.
    let drift=vec2<f32>(frost_noise(p*0.42),frost_noise(p*0.42+vec2<f32>(37.0,19.0)))-vec2<f32>(0.5);
    let shore_fields=frost_ground(p+drift*1.4);let fields=frost_ground(p);
    let soil_uv=p*0.32;let snow_uv=p*0.5;let stone_uv=p*0.32;
    let litter=mengine_texture_soil(soil_uv).rgb;let snow=mengine_texture_snow(snow_uv).rgb;let stone=mengine_texture_stone(stone_uv).rgb;
    let soil_nrh=mengine_texture_soil_nrh(soil_uv);let snow_nrh=mengine_texture_snow_nrh(snow_uv);let stone_nrh=mengine_texture_stone_nrh(stone_uv);
    let cover=0.46+0.28*sin(p.x*0.19+sin(p.y*0.23))+0.18*sin(p.y*0.31-p.x*0.11);
    // Relative scan heights break the snow edge around raised litter and stones without changing walkability.
    let snow_cover=smoothstep(0.32,0.62,cover+(snow_nrh.a-soil_nrh.a)*0.28);
    let road=smoothstep(0.22,0.8,fields.y+(stone_nrh.a-0.5)*0.18);
    let shore=shore_fields.x+(frost_noise(p*2.3)-0.5)*0.065;
    let water=smoothstep(0.46,0.6,shore);let wet=smoothstep(0.18,0.51,shore);let depth=smoothstep(0.57,0.96,shore);
    let soil=mix(litter*vec3<f32>(0.72,0.76,0.69),snow*vec3<f32>(0.82,0.88,0.93),snow_cover);
    let dry=mix(soil,stone*vec3<f32>(0.67,0.66,0.62),road);
    let gravel_mix=0.45+frost_noise(p*1.6)*0.35;let gravel=mix(litter,stone,gravel_mix);
    let bank=mix(dry,gravel*vec3<f32>(0.31,0.34,0.3),wet);
    let wave=sin(p.x*4.2+p.y*2.6+frost_noise(p*0.8)*5.0);
    let ripples=wave*0.003+sin(p.y*8.3-p.x*1.1)*0.0015;
    let shallow=mix(gravel*vec3<f32>(0.22,0.35,0.3),vec3<f32>(0.038,0.108,0.104),0.55);
    s.base_color=mix(bank,mix(shallow,vec3<f32>(0.019,0.049,0.061),depth)+ripples,water);
    let foam=(smoothstep(0.46,0.51,shore)-smoothstep(0.53,0.59,shore))*smoothstep(0.58,0.82,frost_noise(p*3.7));
    s.base_color=mix(s.base_color,vec3<f32>(0.19,0.25,0.24),foam*0.34);
    let packed=mix(mix(mix(soil_nrh,snow_nrh,snow_cover),stone_nrh,road),mix(soil_nrh,stone_nrh,gravel_mix),wet);
    s.roughness=mix(mix(clamp(packed.b,0.48,1.0),0.4,wet),0.23,water);s.metallic=0.0;
    let ground_normal=frost_bump(packed,geometric,vec3<f32>(1,0,0),vec3<f32>(0,0,1),0.7);
    let water_normal=normalize(geometric+vec3<f32>(wave*0.045,0.0,cos(p.y*8.3-p.x*1.1)*0.035));
    s.normal=normalize(mix(ground_normal,water_normal,water));
    let cliff=1.0-smoothstep(0.3,0.85,abs(geometric.y));
    let side_x=vec2<f32>(p.y,-world_position.y)*0.32;let side_z=vec2<f32>(p.x,-world_position.y)*0.32;
    let side_weight=abs(geometric.x)/max(abs(geometric.x)+abs(geometric.z),0.0001);
    let side_nx=mengine_texture_stone_nrh(side_x);let side_nz=mengine_texture_stone_nrh(side_z);
    let side_color=mix(mengine_texture_stone(side_z).rgb,mengine_texture_stone(side_x).rgb,side_weight);
    let side_normal=normalize(mix(frost_bump(side_nz,geometric,vec3<f32>(1,0,0),vec3<f32>(0,-1,0),0.8),frost_bump(side_nx,geometric,vec3<f32>(0,0,1),vec3<f32>(0,-1,0),0.8),side_weight));
    s.base_color=mix(s.base_color,side_color*vec3<f32>(0.48,0.51,0.53),cliff);
    s.normal=normalize(mix(s.normal,side_normal,cliff));s.roughness=mix(s.roughness,mix(side_nz.b,side_nx.b,side_weight),cliff);
    return s;
}
fn mengine_surface_hook(color: vec4<f32>, uv: vec2<f32>, world_position: vec3<f32>, world_normal: vec3<f32>) -> vec4<f32> {
    let fog=frost_ground(world_position.xz).z;
    return vec4<f32>(mix(vec3<f32>(0.012,0.025,0.038),color.rgb,smoothstep(0.05,1.0,fog)),1.0);
}
