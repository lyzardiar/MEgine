/* MENGINE_PARAMETERS
{"parameters":[{"name":"clock","type":"vector4","default":[0,0,0,0]}]}
*/
fn hash21(p: vec2<f32>) -> f32 { return fract(sin(dot(p,vec2<f32>(127.1,311.7)))*43758.5453); }
fn cloud(p: vec2<f32>) -> f32 {
    let i=floor(p); let f=fract(p); let u=f*f*(3.0-2.0*f);
    return mix(mix(hash21(i),hash21(i+vec2<f32>(1.0,0.0)),u.x),mix(hash21(i+vec2<f32>(0.0,1.0)),hash21(i+vec2<f32>(1.0)),u.x),u.y);
}
fn mengine_ui_hook(input: MEngineUiInput) -> vec4<f32> {
    let t=mengine_param_clock(input.instance_index).x;
    let p=input.uv0*vec2<f32>(3.0,1.65)+vec2<f32>(0.0,-t*0.008);
    let n=cloud(p*3.0)*0.55+cloud(p*6.0)*0.28+cloud(p*13.0)*0.12;
    let ribbon=exp(-pow((p.x-1.48+sin(p.y*3.0)*0.28)*3.0,2.0));
    var color=vec3<f32>(0.004,0.007,0.025)+vec3<f32>(0.045,0.012,0.09)*n*n*2.0+vec3<f32>(0.007,0.065,0.12)*ribbon*n;
    let grid=p*135.0; let cell=floor(grid); let point=fract(grid)-vec2<f32>(0.5);
    let seed=hash21(cell); let star=exp(-dot(point,point)*350.0)*step(0.965,seed)*(0.55+0.35*sin(t*1.4+seed*60.0));
    color+=vec3<f32>(0.4,0.72,1.0)*star;
    let planet=length((input.uv0-vec2<f32>(0.65,-0.24))*vec2<f32>(1.75,1.0));
    color+=vec3<f32>(0.015,0.19,0.3)*exp(-pow((planet-0.45)*70.0,2.0));
    return vec4<f32>(color,1.0);
}
