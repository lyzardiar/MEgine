/* MENGINE_PARAMETERS
{"parameters":[{"name":"clock","type":"vector4","default":[0,0,0,0]}]}
*/
fn mengine_ui_hook(input: MEngineUiInput) -> vec4<f32> {
    let t=mengine_param_clock(input.instance_index).x;
    let uv=input.uv0;
    let edge=pow(abs(uv.x-0.5)*2.0,16.0);
    let scan=pow(max(0.0,sin(uv.y*72.0-t*2.5)),32.0)*0.04;
    let grid=step(0.987,fract(uv.x*10.0))*0.025+step(0.99,fract(uv.y*18.0-t*0.035))*0.025;
    return vec4<f32>(vec3<f32>(0.01,0.06,0.105)+vec3<f32>(0.02,0.15,0.24)*(edge+scan+grid),edge*0.65+scan+grid);
}
