/* MENGINE_PARAMETERS
{"parameters":[{"name":"tint0","type":"vector4","default":[1,1,1,1]},{"name":"tint1","type":"vector4","default":[1,1,1,1]},{"name":"tint2","type":"vector4","default":[1,1,1,1]},{"name":"tint3","type":"vector4","default":[1,1,1,1]},{"name":"tint4","type":"vector4","default":[1,1,1,1]},{"name":"tint5","type":"vector4","default":[1,1,1,1]},{"name":"tint6","type":"vector4","default":[1,1,1,1]},{"name":"tint7","type":"vector4","default":[1,1,1,1]},{"name":"tint8","type":"vector4","default":[1,1,1,1]}]}
*/
fn tint_decode(color: vec3<f32>) -> vec3<f32> {
    return select(pow((color + vec3<f32>(0.055)) / 1.055, vec3<f32>(2.4)), color / 12.92, color <= vec3<f32>(0.04045));
}
fn tint_encode(color: vec3<f32>) -> vec3<f32> {
    return select(1.055 * pow(max(color, vec3<f32>(0.0)), vec3<f32>(1.0 / 2.4)) - vec3<f32>(0.055), color * 12.92, color <= vec3<f32>(0.0031308));
}
fn mengine_ui_hook(input: MEngineUiInput) -> vec4<f32> {
    let i = input.instance_index;
    let colors = array<vec4<f32>, 9>(mengine_param_tint0(i), mengine_param_tint1(i), mengine_param_tint2(i), mengine_param_tint3(i), mengine_param_tint4(i), mengine_param_tint5(i), mengine_param_tint6(i), mengine_param_tint7(i), mengine_param_tint8(i));
    let position = vec2<f32>(input.uv0.x, 1.0 - input.uv0.y) + vec2<f32>(0.5);
    let cell = vec2<u32>(floor(position));
    let f = fract(position);
    let index = cell.y * 3u + cell.x;
    let a = round(clamp(colors[index], vec4<f32>(0.0), vec4<f32>(1.0)) * 255.0) / 255.0;
    let b = round(clamp(colors[index + 1u], vec4<f32>(0.0), vec4<f32>(1.0)) * 255.0) / 255.0;
    let c = round(clamp(colors[index + 3u], vec4<f32>(0.0), vec4<f32>(1.0)) * 255.0) / 255.0;
    let d = round(clamp(colors[index + 4u], vec4<f32>(0.0), vec4<f32>(1.0)) * 255.0) / 255.0;
    let tint = mix(mix(a, b, f.x), mix(c, d, f.x), f.y);
    let texel = mengine_ui_main_texture(input.uv0);
    return vec4<f32>(tint_decode(tint_encode(texel.rgb) * tint.rgb), texel.a * tint.a) * input.vertex_color;
}
