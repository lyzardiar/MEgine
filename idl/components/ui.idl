/// Author: MiYu

/// Unity-like uGUI components. SpriteRenderer stays world-space (core.idl).

component Canvas {
  enabled:       bool   = true
  /// "ScreenSpaceOverlay" | "ScreenSpaceCamera" | "WorldSpace"
  render_mode:   string = "ScreenSpaceOverlay"
  /// Stable entity id of the Camera2D/Camera3D used by camera/world modes; empty uses the active camera.
  render_camera: string = ""
  pixel_perfect: bool   = false
  /// Nested canvases inherit the root setting unless this is enabled.
  override_pixel_perfect: bool = false
  override_sorting: bool = false
  sorting_layer: string = "default"
  sorting_order:  int    = 0
  /// Normalized spatial cell size used by the Canvas overlap-aware batch builder; 0 uses 0.1.
  normalized_sorting_grid_size: float = 0.1
  /// Unity AdditionalCanvasShaderChannels bit mask: UV1=1, UV2=2, UV3=4, Normal=8, Tangent=16.
  additional_shader_channels: int = 0
  /// Overlay output display index. Camera mode follows the assigned camera display.
  target_display: int    = 0
  plane_distance: float  = 100
}

/// Unity CanvasRenderer state owned by a UI Graphic entity.
component CanvasRenderer {
  /// Ignore emitted geometry when every vertex color alpha is close to zero.
  cull_transparent_mesh: bool = true
}

/// Unity-style Canvas raycaster. Removing or disabling it keeps rendering active but disables UI hits.
component GraphicRaycaster {
  enabled:                  bool = true
  ignore_reversed_graphics: bool = true
  /// "None" | "TwoD" | "ThreeD" | "All"
  blocking_objects:         string = "None"
  /// Unity-style signed 32-bit LayerMask. -1 includes every layer.
  blocking_mask:            int = -1
}

component CanvasScaler {
  /// "ConstantPixelSize" | "ScaleWithScreenSize" | "ConstantPhysicalSize"
  ui_scale_mode:             string  = "ConstantPixelSize"
  reference_pixels_per_unit: float   = 100
  scale_factor:              float   = 1
  reference_resolution:      float2  = [800, 600]
  /// "MatchWidthOrHeight" | "Expand" | "Shrink"
  screen_match_mode:         string  = "MatchWidthOrHeight"
  match_width_or_height:     float   = 0
  /// "Centimeters" | "Millimeters" | "Inches" | "Points" | "Picas"
  physical_unit:             string  = "Points"
  fallback_screen_dpi:       float   = 96
  default_sprite_dpi:        float   = 96
  dynamic_pixels_per_unit:   float   = 1
}

component RectTransform {
  anchor_min:         float2 = [0.5, 0.5]
  anchor_max:         float2 = [0.5, 0.5]
  pivot:              float2 = [0.5, 0.5]
  anchored_position:  float2 = [0, 0]
  size_delta:         float2 = [100, 100]
  local_rotation:     float  = 0
  local_scale:        float2 = [1, 1]
}

/// Unity-style aspect ratio layout controller.
component AspectRatioFitter {
  /// "None" | "WidthControlsHeight" | "HeightControlsWidth" | "FitInParent" | "EnvelopeParent"
  aspect_mode:  string = "None"
  aspect_ratio: float  = 1
}

/// Unity-style self sizing driven by the attached LayoutGroup.
component ContentSizeFitter {
  /// "Unconstrained" | "MinSize" | "PreferredSize"
  horizontal_fit: string = "Unconstrained"
  /// "Unconstrained" | "MinSize" | "PreferredSize"
  vertical_fit:   string = "Unconstrained"
}

/// Per-child sizing overrides consumed by a parent LayoutGroup.
component LayoutElement {
  ignore_layout:    bool  = false
  min_width:        float = -1
  min_height:       float = -1
  max_width:        float = -1
  max_height:       float = -1
  preferred_width:  float = -1
  preferred_height: float = -1
  flexible_width:   float = -1
  flexible_height:  float = -1
  /// Distance from the child's top edge to its first text baseline; negative uses the preferred-height fallback.
  baseline:          float = -1
  /// Optional per-child axis alignment: "Auto" | "Min" | "Center" | "Max" | "Stretch".
  horizontal_align:  string = "Auto"
  vertical_align:    string = "Auto"
  /// Grid-only zero-based placement; negative values use automatic row-major flow.
  grid_column:       int   = -1
  grid_row:          int   = -1
  grid_column_span:  int   = 1
  grid_row_span:     int   = 1
  /// Grid-only: "Auto" | "Min" | "Center" | "Max" | "Stretch"
  grid_horizontal_align: string = "Auto"
  grid_vertical_align:   string = "Auto"
}

component Image {
  enabled:         bool   = true
  /// Unity MaskableGraphic.maskable. False ignores parent Mask and RectMask2D.
  maskable:        bool   = true
  /// Unity Graphic.material replacement. Empty uses the built-in UI material.
  material:        string = ""
  sprite:          string = "white"
  color:           float4 = [1, 1, 1, 1]
  /// "Simple" | "Sliced" | "Tiled" | "Filled" (Unity Image.type)
  image_type:      string = "Simple"
  /// Preserve the Sprite aspect ratio inside the RectTransform for Simple/Filled images.
  preserve_aspect: bool   = false
  /// Render the center region of a bordered Sliced image.
  fill_center:     bool   = true
  /// Image-local density multiplier used by Unity Sliced and Tiled geometry.
  pixels_per_unit_multiplier: float = 1
  /// "Horizontal" | "Vertical" | "Radial90" | "Radial180" | "Radial360"
  fill_method:     string = "Radial360"
  /// Visible fraction for Filled images, clamped to 0..1.
  fill_amount:     float  = 1
  /// Fill direction for radial methods.
  fill_clockwise:  bool   = true
  /// Method-specific Unity origin enum value.
  fill_origin:     int    = 0
  /// Sprite border in pixels: left, bottom, right, top.
  border:          float4 = [0, 0, 0, 0]
  /// Imported source texture size used to normalize sliced UVs.
  source_size:     float2 = [100, 100]
  raycast_target:  bool   = true
  /// Unity Graphic.raycastPadding: left, bottom, right, top. Positive values shrink the hit area.
  raycast_padding: float4 = [0, 0, 0, 0]
  /// Reject raycasts whose sampled Sprite alpha is below this Unity-style threshold.
  alpha_hit_test_minimum_threshold: float = 0
}

/// Unity-style texture view with an explicit normalized UV rectangle.
component RawImage {
  enabled:         bool   = true
  /// Unity MaskableGraphic.maskable. False ignores parent Mask and RectMask2D.
  maskable:        bool   = true
  /// Unity Graphic.material replacement. Empty uses the built-in UI material.
  material:        string = ""
  texture:        string = "white"
  color:          float4 = [1, 1, 1, 1]
  uv_rect:        float4 = [0, 0, 1, 1]
  raycast_target: bool   = true
  /// Unity Graphic.raycastPadding: left, bottom, right, top. Positive values shrink the hit area.
  raycast_padding: float4 = [0, 0, 0, 0]
}

/// Unity-style Graphic shadow effect.
component Shadow {
  effect_color:      float4 = [0, 0, 0, 0.5]
  effect_distance:   float2 = [1, -1]
  use_graphic_alpha: bool   = true
}

/// Unity-style four-direction Graphic outline effect.
component Outline {
  effect_color:      float4 = [0, 0, 0, 0.5]
  effect_distance:   float2 = [1, -1]
  use_graphic_alpha: bool   = true
}

component Button {
  interactable:    bool   = true
  /// "None" | "ColorTint" | "SpriteSwap"
  transition:      string = "ColorTint"
  /// Unity ColorBlock values multiplied into the target Graphic for each Selectable state.
  normal_color:      float4 = [1, 1, 1, 1]
  highlighted_color: float4 = [0.9607843, 0.9607843, 0.9607843, 1]
  pressed_color:     float4 = [0.7843137, 0.7843137, 0.7843137, 1]
  selected_color:    float4 = [0.9607843, 0.9607843, 0.9607843, 1]
  disabled_color:    float4 = [0.5215686, 0.5215686, 0.5215686, 0.5019608]
  color_multiplier: float   = 1
  fade_duration:    float   = 0.1
  /// Unity SpriteState overrides. Empty entries keep the Image's authored Sprite.
  highlighted_sprite: string = ""
  pressed_sprite:     string = ""
  selected_sprite:    string = ""
  disabled_sprite:    string = ""
  label:           string = "Button"
  text_color:      float4 = [1, 1, 1, 1]
  /// Font asset used by the button label. Empty uses the built-in fallback.
  font:            string = ""
  font_size:       float  = 16
  /// Unity-style persistent call descriptor
  on_click:        object
}

component Text {
  enabled:         bool   = true
  /// Unity MaskableGraphic.maskable. False ignores parent Mask and RectMask2D.
  maskable:        bool   = true
  /// Unity Graphic.material replacement. Empty uses the built-in UI material.
  material:        string = ""
  text:            string = "Text"
  color:           float4 = [1, 1, 1, 1]
  /// Unity Text.font. Empty uses MEngine's bounded built-in fallback.
  font:            string = ""
  font_size:       float  = 16
  /// Unity FontStyle: "Normal" | "Bold" | "Italic" | "BoldAndItalic".
  font_style:      string = "Normal"
  /// Unity Text.alignByGeometry. Aligns visible glyph bounds instead of advance metrics.
  align_by_geometry: bool = false
  /// Unity Text.supportRichText. Interprets legacy b/i/size/color markup when enabled.
  support_rich_text: bool = true
  /// Unity Text.resizeTextForBestFit. Chooses the largest fitting integer size in the range.
  resize_text_for_best_fit: bool = false
  /// Unity Text.resizeTextMinSize.
  resize_text_min_size: int = 10
  /// Unity Text.resizeTextMaxSize.
  resize_text_max_size: int = 40
  outline_color:   float4 = [0, 0, 0, 1]
  outline_width:   float  = 0
  /// "Left" | "Center" | "Right"
  alignment:       string = "Center"
  /// "Top" | "Middle" | "Bottom"
  vertical_align:  string = "Middle"
  /// Multiplier applied to the font line height. Unity uses 1 for normal spacing.
  line_spacing:    float  = 1
  /// "Wrap" | "Overflow"
  horizontal_overflow: string = "Wrap"
  /// "Truncate" | "Overflow"
  vertical_overflow:   string = "Truncate"
  raycast_target:  bool   = true
  /// Unity Graphic.raycastPadding: left, bottom, right, top. Positive values shrink the hit area.
  raycast_padding: float4 = [0, 0, 0, 0]
}

component Toggle {
  is_on:            bool   = false
  interactable:     bool   = true
  label:            string = "Toggle"
  color:            float4 = [0.2, 0.45, 0.85, 1]
  text_color:       float4 = [1, 1, 1, 1]
  /// Font asset used by the toggle label. Empty uses the built-in fallback.
  font:             string = ""
  font_size:        float  = 16
  on_value_changed: object
}

/// Mutual-exclusion group for descendant Toggles. The nearest ancestor group wins.
component ToggleGroup {
  allow_switch_off: bool = false
}

component Slider {
  min_value:        float  = 0
  max_value:        float  = 1
  value:            float  = 0.5
  whole_numbers:    bool   = false
  interactable:     bool   = true
  /// "LeftToRight" | "RightToLeft" | "BottomToTop" | "TopToBottom"
  direction:        string = "LeftToRight"
  fill_color:       float4 = [0.2, 0.55, 1, 1]
  background_color: float4 = [0.15, 0.17, 0.2, 1]
  handle_color:     float4 = [0.9, 0.92, 0.95, 1]
  on_value_changed: object
}

/// Unity-style scrollbar. Size is the normalized handle length in [0, 1].
component Scrollbar {
  value:             float  = 0
  size:              float  = 0.2
  number_of_steps:   int    = 0
  interactable:      bool   = true
  /// "LeftToRight" | "RightToLeft" | "BottomToTop" | "TopToBottom"
  direction:         string = "BottomToTop"
  background_color:  float4 = [0.12, 0.14, 0.18, 1]
  handle_color:      float4 = [0.52, 0.58, 0.68, 1]
  on_value_changed:  object
}

/// Background/container control inspired by Godot PanelContainer and FairyGUI GComponent.
component Panel {
  enabled:        bool   = true
  /// Unity MaskableGraphic.maskable. False ignores parent Mask and RectMask2D.
  maskable:       bool   = true
  /// Replacement UI material. Empty uses the built-in UI material.
  material:       string = ""
  color:          float4 = [0.12, 0.14, 0.18, 0.96]
  border_color:   float4 = [0.32, 0.36, 0.44, 1]
  border_width:   float  = 1
  raycast_target: bool   = false
  /// Unity Graphic.raycastPadding: left, bottom, right, top. Positive values shrink the hit area.
  raycast_padding: float4 = [0, 0, 0, 0]
}

/// Inherited opacity/input state for a UI subtree.
component CanvasGroup {
  alpha:           float = 1
  interactable:    bool  = true
  blocks_raycasts: bool  = true
  /// Ignore CanvasGroup state inherited from ancestors and start a new group boundary.
  ignore_parent_groups: bool = false
}

/// Automatic child arrangement: "Horizontal" | "Vertical" | "Grid".
component LayoutGroup {
  direction:                 string = "Vertical"
  padding:                   float4 = [8, 8, 8, 8]
  spacing:                   float2 = [6, 6]
  /// Horizontal/Vertical only: wrap children into additional tracks.
  wrap:                      bool   = false
  /// Space between wrapped rows/columns. A negative value reuses the matching item spacing.
  counter_spacing:           float  = -1
  /// "Packed" | "SpaceBetween"
  main_axis_distribution:    string = "Packed"
  /// Wrapped tracks: "Packed" | "SpaceBetween"
  counter_axis_distribution: string = "Packed"
  /// "Auto" | "Baseline"; the normal nine-way child_alignment handles other values.
  counter_axis_alignment:    string = "Auto"
  cell_size:                 float2 = [120, 32]
  /// "UpperLeft" | "UpperCenter" | "UpperRight" | "MiddleLeft" | "MiddleCenter" | "MiddleRight" | "LowerLeft" | "LowerCenter" | "LowerRight"
  child_alignment:           string = "UpperLeft"
  child_control_width:       bool   = true
  child_control_height:      bool   = true
  /// Backward-compatible master switch for both force-expand axes.
  child_force_expand:        bool   = true
  child_force_expand_width:  bool   = true
  child_force_expand_height: bool   = true
  use_child_scale_width:     bool   = false
  use_child_scale_height:    bool   = false
  reverse_arrangement:       bool   = false
  /// Reverse only visual stacking while preserving layout order.
  reverse_z_order:           bool   = false
  /// Grid only: "UpperLeft" | "UpperRight" | "LowerLeft" | "LowerRight"
  start_corner:              string = "UpperLeft"
  /// Grid only: "Horizontal" | "Vertical"
  start_axis:                string = "Horizontal"
  /// Grid only: "Flexible" | "FixedColumnCount" | "FixedRowCount"
  constraint:                string = "FixedColumnCount"
  constraint_count:          int    = 1
  /// Grid dimensions. Zero derives the missing dimension from the child count.
  grid_columns:              int    = 0
  grid_rows:                 int    = 0
  /// Stretch grid tracks to the available content width/height.
  grid_fit_width:            bool   = false
  grid_fit_height:           bool   = false
}

/// Rectangular child clipping. Padding order is left, bottom, right, top.
component RectMask2D {
  enabled: bool   = true
  padding: float4 = [0, 0, 0, 0]
  /// Inner edge fade distances in Canvas pixels: horizontal, vertical.
  softness: float2 = [0, 0]
}

/// Unity-style alpha/stencil mask driven by a Graphic on the same entity.
component Mask {
  enabled:           bool = true
  show_mask_graphic: bool = true
}

component ProgressBar {
  min_value:        float  = 0
  max_value:        float  = 1
  value:            float  = 0.5
  direction:        string = "LeftToRight"
  background_color: float4 = [0.12, 0.14, 0.18, 1]
  fill_color:       float4 = [0.2, 0.65, 0.95, 1]
  text_color:       float4 = [1, 1, 1, 1]
  show_label:       bool   = true
  /// Font asset used by the percentage label. Empty uses the built-in fallback.
  font:             string = ""
  font_size:        float  = 14
}

component InputField {
  text:             string = ""
  placeholder:      string = "Enter text..."
  text_color:       float4 = [0.94, 0.95, 0.98, 1]
  placeholder_color: float4 = [0.55, 0.58, 0.64, 1]
  background_color: float4 = [0.08, 0.09, 0.12, 1]
  caret_color:      float4 = [0.3, 0.7, 1, 1]
  /// Font asset used by entered text and placeholder text. Empty uses the built-in fallback.
  font:             string = ""
  font_size:        float  = 16
  interactable:     bool   = true
  multiline:        bool   = false
  character_limit:  int    = 0
  on_value_changed: object
  on_submit:        object
}

component Dropdown {
  options:          string_array = []
  selected_index:   int    = 0
  expanded:         bool   = false
  interactable:     bool   = true
  background_color: float4 = [0.13, 0.15, 0.19, 1]
  item_color:       float4 = [0.16, 0.18, 0.23, 1]
  selected_color:   float4 = [0.2, 0.48, 0.85, 1]
  text_color:       float4 = [1, 1, 1, 1]
  /// Font asset used by the selected value and option rows. Empty uses the built-in fallback.
  font:             string = ""
  font_size:        float  = 16
  on_value_changed: object
}

component ListView {
  items:            string_array = []
  selected_index:   int    = -1
  item_height:      float  = 32
  spacing:          float  = 2
  scroll_offset:    float  = 0
  interactable:     bool   = true
  background_color: float4 = [0.08, 0.09, 0.12, 1]
  item_color:       float4 = [0.14, 0.16, 0.2, 1]
  selected_color:   float4 = [0.2, 0.48, 0.85, 1]
  text_color:       float4 = [1, 1, 1, 1]
  /// Font asset used by item labels. Empty uses the built-in fallback.
  font:             string = ""
  font_size:        float  = 15
  on_value_changed: object
}

component ScrollView {
  horizontal:          bool   = false
  vertical:            bool   = true
  normalized_position: float2 = [0, 0]
  scroll_sensitivity:  float  = 0.08
  viewport_color:      float4 = [0.05, 0.06, 0.08, 0.72]
  show_scrollbar:      bool   = true
  on_value_changed:    object
}

component TabView {
  tabs:             string_array = []
  selected_index:   int    = 0
  tab_height:       float  = 32
  interactable:     bool   = true
  background_color: float4 = [0.09, 0.1, 0.13, 1]
  tab_color:        float4 = [0.15, 0.17, 0.21, 1]
  selected_color:   float4 = [0.2, 0.48, 0.85, 1]
  text_color:       float4 = [1, 1, 1, 1]
  /// Font asset used by tab labels. Empty uses the built-in fallback.
  font:             string = ""
  font_size:        float  = 15
  on_value_changed: object
}
