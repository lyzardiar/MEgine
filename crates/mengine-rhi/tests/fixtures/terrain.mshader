            s.base_color=mix(vec3<f32>(0.06,0.17,0.16),vec3<f32>(0.025,0.085,0.105),deep)+vec3<f32>(foam_line*0.12);
            s.normal=normalize(geometric+vec3<f32>(wave*0.075,0.0,cross_wave*0.055));s.roughness=0.16;
