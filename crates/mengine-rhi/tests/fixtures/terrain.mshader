    let side_x=vec2<f32>(p.y,-world_position.y)*mapping.xy;let side_z=vec2<f32>(p.x,-world_position.y)*mapping.xy;
    let side_weight=abs(geometric.x)/max(abs(geometric.x)+abs(geometric.z),0.0001);
    // MiYu: cliff color and linear NRH reuse the standard color/MR bindings; this hook supplies all final PBR channels.
    let scan_x=frost_cliff(side_x,cliff_style);let scan_z=frost_cliff(side_z,cliff_style);
    let side_nx=scan_x.nrh;let side_nz=scan_z.nrh;let side_color=mix(scan_z.color,scan_x.color,side_weight);
    let side_normal=normalize(mix(frost_bump(side_nz,geometric,vec3<f32>(1,0,0),vec3<f32>(0,-1,0),mapping.z),frost_bump(side_nx,geometric,vec3<f32>(0,0,1),vec3<f32>(0,-1,0),mapping.z),side_weight));
    // MiYu: the same scanned rock wraps over exposed crowns and breaks through the soil on ramps.
    let crown_uv=p*mapping.xy;
    let crown=frost_cliff(crown_uv,cliff_style);let crown_nrh=crown.nrh;
    let crown_color=crown.color*vec3<f32>(0.78,0.82,0.86);
    let outcrop=smoothstep(0.12,0.72,rim+slope*0.35+(crown_nrh.a-soil_nrh.a)*0.18)*(1.0-snow_cover)*(1.0-road*0.8)*(1.0-wet);
    s.base_color=mix(s.base_color,crown_color,outcrop);
    s.normal=normalize(mix(s.normal,frost_bump(crown_nrh,geometric,vec3<f32>(1,0,0),vec3<f32>(0,0,1),mapping.z),outcrop));
    s.roughness=mix(s.roughness,clamp(crown_nrh.b,0.48,1.0),outcrop);
    // MiYu: mesh UVs carry cliff depth; exposed shelves keep a soil cap and shaded rock foot.
    let cap=1.0-smoothstep(0.02,0.20,wall_depth+(side_nz.a-0.5)*0.10);
    let foot=mix(1.0,0.67,smoothstep(0.55,1.0,contact));
    // MiYu: the shelf's painted ground continues over the lip; winter snow settles on upward rock ledges.
    let cap_ground=mix(litter*soil_tint*damp,grass,grass_cover);let cap_snow=smoothstep(0.4,0.7,cover)*(1.0-smoothstep(0.02,0.20,wall_depth));
    let cap_color=mix(mix(crown_color,cap_ground,0.65+medium*0.15),snow_color,cap_snow);
    // MiYu: broad rock faces retain soil crowns and subtle shading at each two-unit joint.
    let course=fract(wall_depth*0.5);let rock_course=select(0.0,1.0,cliff_style==0.0);
    let ledge=rock_course*smoothstep(0.25,0.7,geometric.y)*(1.0-smoothstep(0.05,0.45,course));
    let strata=1.0-rock_course*0.08*(1.0-smoothstep(0.0,0.12,course));
