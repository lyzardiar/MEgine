fn mengine_lit_surface_hook(surface: MEngineSurface, uv: vec2<f32>, world_position: vec3<f32>) -> MEngineSurface {
    var s=surface;let p=world_position.xz;let geometric=normalize(surface.normal);let tileset=clamp(floor(mengine_param_tileset().x),0.0,2.0);
    let cliff_style=clamp(floor(uv.x/2.0),0.0,2.0);let contact=clamp(uv.x-cliff_style*2.0,0.0,1.0);
