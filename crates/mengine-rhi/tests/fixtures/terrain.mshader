    let soil_nrh=mix(soil_a,soil_b,soil_weight);let snow_nrh=mix(snow_a,snow_b,snow_weight);let stone_nrh=mengine_texture_stone_nrh(stone_uv);
    let grass_uv=p*0.36;let grass_a=frost_atlas_nrh(grass_uv,1.0);let grass_b=frost_atlas_nrh(grass_uv+offset,1.0);let grass_weight=frost_tile_weight(tile_amount,grass_a,grass_b);
