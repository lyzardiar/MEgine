// MiYu: wrapped gutters and explicit gradients keep soil/grass atlas panels separate at tile repeats.
fn frost_atlas_uv(uv: vec2<f32>, layer: f32) -> vec2<f32> { return (fract(uv)*1024.0+vec2<f32>(4.0+layer*1032.0,4.0))/vec2<f32>(2064.0,1032.0); }
fn frost_atlas_color(uv: vec2<f32>, layer: f32) -> vec3<f32> {
    let scale=vec2<f32>(1024.0/2064.0,1024.0/1032.0);
    return textureSampleGrad(mengine_custom_texture_0,material_sampler,frost_atlas_uv(uv,layer),dpdx(uv)*scale,dpdy(uv)*scale).rgb;
}
fn frost_atlas_nrh(uv: vec2<f32>, layer: f32) -> vec4<f32> {
    let scale=vec2<f32>(1024.0/2064.0,1024.0/1032.0);
    return textureSampleGrad(mengine_custom_texture_3,material_sampler,frost_atlas_uv(uv,layer),dpdx(uv)*scale,dpdy(uv)*scale);
}
// MiYu: each cliff tile selects a wrapped scan panel; gradients exclude the atlas layer offset.
fn frost_cliff_uv(uv: vec2<f32>, layer: f32) -> vec2<f32> { return (fract(uv)*1024.0+vec2<f32>(4.0+layer*1032.0,4.0))/vec2<f32>(3096.0,1032.0); }
fn frost_cliff_color(uv: vec2<f32>, layer: f32) -> vec3<f32> {
    let scale=vec2<f32>(1024.0/3096.0,1024.0/1032.0);
    return textureSampleGrad(base_color_texture,material_sampler,frost_cliff_uv(uv,layer),dpdx(uv)*scale,dpdy(uv)*scale).rgb;
}
fn frost_cliff_nrh(uv: vec2<f32>, layer: f32) -> vec4<f32> {
    let scale=vec2<f32>(1024.0/3096.0,1024.0/1032.0);
    return textureSampleGrad(metallic_roughness_texture,material_sampler,frost_cliff_uv(uv,layer),dpdx(uv)*scale,dpdy(uv)*scale);
}
struct FrostCliff { color: vec3<f32>, nrh: vec4<f32> }
// MiYu: translated scans share one height-aware weight in world space, including adjacent cliff chunks.
fn frost_cliff(uv: vec2<f32>, layer: f32) -> FrostCliff {
    let offset=vec2<f32>(0.37,0.61);let first=frost_cliff_nrh(uv,layer);let second=frost_cliff_nrh(uv+offset,layer);
    let weight=frost_tile_weight(frost_noise(uv*0.73+vec2<f32>(17.0,9.0)),first,second);
    return FrostCliff(mix(frost_cliff_color(uv,layer),frost_cliff_color(uv+offset,layer),weight),mix(first,second,weight));
